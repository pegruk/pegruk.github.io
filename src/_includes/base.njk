<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  <script>try{const t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch{}</script>
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  {% if layout == 'post.njk' %}<link rel="stylesheet" href="{{ '/assets/katex/katex.min.css' | url }}">{% endif %}
  <script src="{{ '/assets/app.js' | url }}" defer></script>
</head>
<body class="{% if page.url == '/' %}home{% else %}reading-page{% endif %}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="name" href="{{ '/' | url }}"><span class="brand-mark" aria-hidden="true">p.</span>{{ site.name }}</a>
    <nav aria-label="Main navigation">
      <details class="categories"><summary>Categories</summary><div class="category-menu"><a href="{{ '/' | url }}">All posts</a>{% for category in collections.categories %}<a href="{{ '/' | url }}?category={{ category | urlencode }}">{{ category }}</a>{% endfor %}</div></details>
      <a href="{{ '/about/' | url }}" {% if page.url == '/about/' %}aria-current="page"{% endif %}>About me</a>
      <button class="icon-button" id="theme-toggle" aria-label="Switch color theme" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/></svg></button>
      <button class="icon-button" id="search-open" aria-label="Search articles" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
    </nav>
  </header>
  <main id="main">{{ content | safe }}</main>
  <footer><span>{{ site.name }}<span class="footer-note">A work in progress, always.</span></span><a href="{{ '/about/' | url }}">Let’s get acquainted <span aria-hidden="true">↗</span></a></footer>
  <dialog id="search-dialog" aria-labelledby="search-title" data-index="{{ '/search.json' | url }}">
    <div class="search-heading"><h2 id="search-title">Search articles</h2><button class="icon-button" id="search-close" aria-label="Close search">×</button></div>
    <label class="sr-only" for="search-input">Search titles and article text</label>
    <input id="search-input" type="search" placeholder="Search titles and article text…" autocomplete="off">
    <p id="search-status" role="status">Type to search all articles.</p>
    <button id="search-retry" hidden>Try again</button>
    <ul id="search-results"></ul>
  </dialog>
</body>
</html>
