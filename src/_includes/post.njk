---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta"><time datetime="{{ date | isoDate }}">{{ date | dateLabel }}</time>{% for category in categories %}<a href="{{ ('/categories/' + (category | categorySlug) + '/') | url }}" data-motion-link>{{ category }}</a>{% endfor %}</p>
    {% if demo %}<p class="demo-label">Demonstration post</p>{% endif %}
  </header>
  <div class="prose">{{ content | safe }}</div>
  <a class="back-link" href="{{ '/' | url }}" data-return-link>Back to all posts</a>
</article>
