---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    {% if demo %}<p class="demo-label">Demonstration post · visible in local preview only</p>{% endif %}
    <h1>{{ title }}</h1>
    <p class="post-meta"><time datetime="{{ date | isoDate }}">{{ date | dateLabel }}</time>{% for category in categories %}<a href="{{ '/' | url }}?category={{ category | urlencode }}">{{ category }}</a>{% endfor %}</p>
  </header>
  <div class="prose">{{ content | safe }}</div>
  <a class="back-link" href="{{ '/' | url }}">Back to all posts</a>
</article>
