---
layout: base.njk
---
<section class="writing" aria-labelledby="writing-title">
<div class="section-heading"><h1 id="writing-title">Latest writing</h1><span>Notes & essays</span></div>
<div id="filter-status" hidden><span></span><a href="{{ '/' | url }}">All posts</a></div>
<ul class="post-list">
{% for post in collections.posts %}
  <li data-categories="{{ post.data.categories | json | escape }}">
    <h3><a class="post-title" href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
    {% if post.data.description %}<p class="post-excerpt">{{ post.data.description }}</p>{% endif %}
    <div class="card-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time><span class="post-category">{{ post.data.categories[0] }}</span></div>
  </li>
{% endfor %}
</ul>
<div id="empty-posts" {% if collections.posts.length %}hidden{% endif %}><h3>The first page is still unwritten.</h3><p>No posts yet. New writing will appear here.</p></div>
<noscript><p>Browse all posts above. Enable JavaScript to filter by category or search.</p></noscript>
</section>
