---
layout: base.njk
---
<section class="introduction" aria-labelledby="intro-title">
  <div class="intro-copy">
    <p class="intro-byline">A notebook by {{ site.name }}</p>
    <h1 id="intro-title">Learning to<br>look closer.</h1>
    <p class="intro-description">Exploring how neural networks work, how to make AI safer, and how to build useful things.</p>
    <a class="intro-about" href="{{ '/about/' | url }}">A little about me <span aria-hidden="true">↗</span></a>
  </div>
  <div class="network-study" aria-hidden="true">
    <svg viewBox="0 0 280 300" fill="none">
      <defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".22"/></pattern></defs>
      <rect x="0" y="0" width="280" height="300" fill="url(#dots)"/>
      <g class="network-lines"><path d="M38 72 111 45 190 92 248 150M38 72 111 115 190 92M38 150 111 45M38 150 111 115 190 160 248 150M38 150 111 195 190 92M38 228 111 115M38 228 111 195 190 230 248 150M38 228 111 265 190 230M111 45 190 160M111 195 190 160M111 265 190 160"/></g>
      <path class="network-active" d="M38 150 111 115 190 160 248 150"/>
      <g class="network-nodes"><circle cx="38" cy="72" r="5"/><circle cx="38" cy="150" r="5"/><circle cx="38" cy="228" r="5"/><circle cx="111" cy="45" r="5"/><circle cx="111" cy="115" r="5"/><circle cx="111" cy="195" r="5"/><circle cx="111" cy="265" r="5"/><circle cx="190" cy="92" r="5"/><circle cx="190" cy="160" r="5"/><circle cx="190" cy="230" r="5"/><circle cx="248" cy="150" r="6"/></g>
      <g class="network-highlight"><circle cx="38" cy="150" r="3"/><circle cx="111" cy="115" r="3"/><circle cx="190" cy="160" r="3"/><circle cx="248" cy="150" r="3"/></g>
      <circle class="network-ring" cx="190" cy="160" r="20"/>
    </svg>
    <span>A closer look at what’s inside.</span>
  </div>
</section>
<section class="writing" aria-labelledby="writing-title">
<div class="section-heading"><h2 id="writing-title">Writing & notes</h2><span>Ideas, experiments, and things in progress</span></div>
<div id="filter-status" hidden><span></span><a href="{{ '/' | url }}">All posts</a></div>
<ul class="post-list">
{% for post in collections.posts %}
  <li data-categories="{{ post.data.categories | json | escape }}">
    <time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time>
    <div class="post-summary"><div class="post-category">{{ post.data.categories[0] }}</div><a class="post-title" href="{{ post.url | url }}">{{ post.data.title }}</a>{% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}{% if post.data.demo %}<span class="demo-marker">Sample article</span>{% endif %}</div>
    <span class="post-direction" aria-hidden="true">↗</span>
  </li>
{% endfor %}
</ul>
<div id="empty-posts" {% if collections.posts.length %}hidden{% endif %}><span class="empty-symbol" aria-hidden="true">✳</span><h3>A fresh page.</h3><p>No posts yet. New writing will appear here.</p></div>
<noscript><p>Browse all posts above. Enable JavaScript to filter by category or search.</p></noscript>
</section>
