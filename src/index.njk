---
layout: base.njk
---
<section class="home-welcome" aria-labelledby="welcome-title">
  <h1 id="welcome-title">{{ site.welcome }}</h1>
  <p>{{ site.description }}</p>
  <div class="social-links" aria-label="Follow the blog">
    <a href="{{ site.github }}" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4 1-4-2-6-2m12 5v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.9A5.4 5.4 0 0 0 18.8 5a5 5 0 0 0-.1-3.6s-1.2-.4-3.9 1.5a13.4 13.4 0 0 0-7 0C5.1 1 3.9 1.4 3.9 1.4A5 5 0 0 0 3.8 5a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.2 6.6 6.2 6.9a3.4 3.4 0 0 0-.9 2.6V22"/></svg></a>
    <a href="{{ '/feed.xml' | url }}" aria-label="RSS feed"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="5" cy="19" r="1.2" fill="currentColor" stroke="none"/><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/></svg></a>
  </div>
</section>
<section class="writing" aria-labelledby="writing-title">
<div class="section-heading"><h2 id="writing-title">All posts</h2><span>Notes & essays</span></div>
<div id="filter-status" hidden><span></span><a href="{{ '/' | url }}">All posts</a></div>
<ul class="post-list">
{% for post in collections.posts %}
  <li data-categories="{{ post.data.categories | json | escape }}">
    <h3><a class="post-title" href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
    {% if post.data.description %}<p class="post-excerpt">{{ post.data.description }}</p>{% endif %}
    <div class="card-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time><span class="post-category">{{ post.data.categories[0] }}</span></div>
  </li>
{% endfor %}
</ul>
<div id="empty-posts" {% if collections.posts.length %}hidden{% endif %}><h3>The first page is still unwritten.</h3><p>No posts yet. New writing will appear here.</p></div>
<noscript><p>Browse all posts above. Enable JavaScript to filter by category or search.</p></noscript>
</section>
